{
  "name": "@ani-uni/fastcap",
  "version": "0.0.3",
  "description": "A tool to quickly configure the map of progress between the videos and the real episodes'.",
  "homepage": "https://github.com/ani-uni/fastcap#readme",
  "bugs": {
    "url": "https://github.com/ani-uni/fastcap/issues"
  },
  "license": "LGPL-3.0-or-later",
  "author": "rinne",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani-uni/fastcap.git"
  },
  "files": [
    "dist"
  ],
